@* "Plan a trip" tab: the trip form and the priced result. It only displays things and reports what the
   user asked for; the search itself (validation, the pipeline, Undo/Redo history) stays in Home because the
   result is shared with the Bookings and Timetable tabs. It receives the form model (Inputs, bound directly
   by the inputs), the last report and its passenger count, the validation message, the selected pipeline
   step (two-way), whether Undo/Redo are possible, and one EventCallback per user action. The cascaded role
   only decides whether the "service failure" shortcut is shown (Home checks the role again before it
   simulates anything); the cascaded ViewOptions decide whether course material is shown. *@

@inject IMappingSystem MappingSystem
@inject ChaosAndTrafficController ChaosController

@if (FailuresSimulated)
{
    <div class="alert warn" role="status">
        <strong>Simulated service failures are switched on</strong>
        <p>A dispatcher is testing how the app handles outages, so searches or payments may fail until they are switched off.</p>
    </div>
}

<div class="grid-2">
    <section class="card">
        <div class="card-head">
            <div>
                <h2>Trip details</h2>
                <p class="card-sub">Stations, departure time, passengers and package.</p>
            </div>
            <div class="inline">
                <button class="btn btn-sm" disabled="@(!CanUndo)" title="Go back to the previous search" @onclick="() => OnUndo.InvokeAsync()">Undo search</button>
                <button class="btn btn-sm" disabled="@(!CanRedo)" title="Go forward to the next search" @onclick="() => OnRedo.InvokeAsync()">Redo</button>
            </div>
        </div>

        <div class="route-row">
            <div class="field">
                <label for="origin">From</label>
                <input id="origin" list="station-list" autocomplete="off" @bind="Inputs.OriginName" placeholder="Station" />
            </div>
            <button class="btn btn-icon" type="button" title="Swap stations" aria-label="Swap From and To" @onclick="Inputs.SwapStations">⇄</button>
            <div class="field">
                <label for="destination">To</label>
                <input id="destination" list="station-list" autocomplete="off" @bind="Inputs.DestinationName" placeholder="Station" />
            </div>
        </div>
        <datalist id="station-list">
            @foreach (var station in Stations)
            {
                <option value="@UiText.Station(station.StationCode)"></option>
            }
        </datalist>

        <div class="form-grid" style="margin-top:0.75rem;">
            <div class="field">
                <label for="departure">Departure</label>
                <input id="departure" type="time" @bind="Inputs.Departure" />
            </div>
            <div class="field">
                <label for="passengers">Passengers</label>
                <input id="passengers" type="number" min="1" max="50" @bind="Inputs.Passengers" />
            </div>
            <div class="field" style="grid-column: 1 / -1;">
                <label for="package">Package</label>
                <select id="package" @bind="Inputs.OfferingKey">
                    @foreach (var (key, label) in PlannerInputs.Packages)
                    {
                        <option value="@key">@label</option>
                    }
                </select>
                <span class="field-hint">@Inputs.ToOffering().Description</span>
            </div>
        </div>

        @if (ValidationWarning is not null)
        {
            <div class="alert warn" role="alert">@ValidationWarning</div>
        }

        <div class="actions">
            <button class="btn btn-primary" @onclick="() => OnSearch.InvokeAsync()">Find route and price</button>
        </div>

        @if (Options.ShowCourseNotes)
        {
            <p class="muted small" style="margin:0.6rem 0 0;">
                Try an edge case:
                <button class="btn-link" @onclick="() => OnUnknownStationDemo.InvokeAsync()">unknown station</button>
                @if (Role == UserRole.DispatcherAdmin)
                {
                    <text> · </text>
                    <button class="btn-link" @onclick="() => OnServiceFailureDemo.InvokeAsync()">service failure</button>
                }
            </p>
        }

        <HowItWorks>
            The input is first classified into a <code>ValidatedUserInput</code> union, and only a
            <code>ValidRouteQuery</code> reaches the pipeline. Packages are another union (<code>CustomerOffering</code>)
            priced with a switch expression. Every search is saved as an immutable snapshot on an
            <code>ImmutableStack</code>, which is what Undo and Redo walk through.
        </HowItWorks>
    </section>

    <section class="card">
        <div class="card-head">
            <h2>Your trip</h2>
        </div>

        @if (Report is null)
        {
            <div class="empty-state">
                <p>Enter two stations and choose <strong>Find route and price</strong>.</p>
            </div>
        }
        else
        {
            <MaybeView TItem="PricedItinerary" State="Report.Outcome" OnRetry="OnRetry">
                <SomethingTemplate Context="trip">
                    @{
                        var route = trip.TrafficRoute.Route;
                        var arrivalStop = RecursiveTimetable.BuildTimetable(route, Inputs.Departure)[^1];
                        var changes = Math.Max(0, route.Segments.Count - 1);
                    }
                    <div class="trip-head">
                        <div class="trip-route">@UiText.Station(route.Origin) → @UiText.Station(route.Destination)</div>
                        <div class="trip-price">@UiText.Money(trip.FinalPrice, trip.Currency)</div>
                    </div>
                    <p class="trip-meta">
                        @UiText.Count(PricedPassengers, "passenger") · @trip.Offering.Title ·
                        @route.TotalDistanceKm.ToString("N0") km
                    </p>

                    <div class="trip-times">
                        <div><span class="muted small">Departs</span><strong>@Inputs.Departure.ToString("HH:mm")</strong></div>
                        <div>
                            <span class="muted small">Arrives</span>
                            <strong>@arrivalStop.Arrival.ToString("HH:mm")@(arrivalStop.DayOffset > 0 ? $" +{arrivalStop.DayOffset}d" : "")</strong>
                        </div>
                        <div>
                            <span class="muted small">Journey</span>
                            <strong>@UiText.Duration(RecursiveTimetable.JourneyMinutes(route))</strong>
                        </div>
                        <div>
                            <span class="muted small">Changes</span>
                            <strong>@(changes == 0 ? "Direct" : changes.ToString())</strong>
                        </div>
                    </div>

                    @if (trip.TrafficRoute.HasRoadworksOrTrackMaintenance)
                    {
                        <div class="alert warn">@trip.TrafficRoute.TrafficAdvisory</div>
                    }

                    <ul class="legs">
                        @foreach (var seg in route.Segments)
                        {
                            <li>
                                <strong>@UiText.Station(seg.FromStation) → @UiText.Station(seg.ToStation)</strong>
                                <span class="leg-info">@seg.LineName · @seg.DistanceKm.ToString("N0") km · @UiText.Duration(seg.BaseMinutes)</span>
                            </li>
                        }
                    </ul>

                    <table class="breakdown">
                        <tbody>
                            <tr><td>Rail fare</td><td>@UiText.Money(trip.BaseFare, trip.Currency)</td></tr>
                            @if (trip.RoadworksSurcharge > 0)
                            {
                                <tr><td>Engineering works surcharge</td><td>+@UiText.Money(trip.RoadworksSurcharge, trip.Currency)</td></tr>
                            }
                            @if (trip.OfferingAddon > 0)
                            {
                                <tr><td>@trip.Offering.Title</td><td>+@UiText.Money(trip.OfferingAddon, trip.Currency)</td></tr>
                            }
                            <tr class="total"><td>Total</td><td>@UiText.Money(trip.FinalPrice, trip.Currency)</td></tr>
                        </tbody>
                    </table>
                    <p class="muted small" style="margin:0.25rem 0 0;">A @UiText.Money(BookingWorkflow.ServiceFee) booking fee is added at checkout.</p>

                    <div class="actions">
                        <button class="btn btn-primary btn-block" @onclick="() => OnBookTrip.InvokeAsync()">Book this trip</button>
                        <button class="btn btn-sm" @onclick="() => OnViewTimetable.InvokeAsync()">View timetable</button>
                    </div>
                </SomethingTemplate>
                <NothingTemplate>
                    <div class="alert warn">
                        <strong>No route found</strong>
                        <p>"@Inputs.OriginName" or "@Inputs.DestinationName" is not a station in our network. Pick a station from the list.</p>
                        <div class="actions">
                            <button class="btn btn-sm" @onclick="() => OnRestoreValidStations.InvokeAsync()">Search London → Zurich instead</button>
                        </div>
                    </div>
                </NothingTemplate>
            </MaybeView>
        }
    </section>
</div>

@if (Options.ShowCourseNotes && Report is not null)
{
    <section class="card">
        <div class="card-head">
            <div>
                <h2>How the search ran</h2>
                <p class="card-sub">Each step receives the value returned by the previous one. Select a step to see its output.</p>
            </div>
        </div>

        <PipelineSteps Diagnostics="Report.Diagnostics"
                       Selected="SelectedStep"
                       OnStepSelected="SelectedStepChanged" />

        @if (SelectedStep is not null)
        {
            <p class="step-detail-panel"><strong>@SelectedStep.StepName:</strong> @SelectedStep.DetailMessage</p>
        }

        <HowItWorks>
            The four services are chained with <code>Bind</code>:
            <code>FindLocation → PlanRoute → CheckForRoadworks → CalculatePrice</code>. Each returns
            <code>Maybe&lt;T&gt;</code>. When one returns <code>Nothing</code> or <code>Error</code>, the later steps are
            skipped instead of throwing, and <code>OnNothing</code> / <code>OnError</code> log the problem once.
            The result card is the generic <code>MaybeView&lt;T&gt;</code> component with one template per case.
        </HowItWorks>
    </section>
}

@code {
    /// <summary>The form fields. Owned by Home; the inputs write into it directly.</summary>
    [Parameter, EditorRequired]
    public PlannerInputs Inputs { get; set; } = new();

    /// <summary>The last search, or null when the form did not pass validation.</summary>
    [Parameter]
    public PipelineExecutionReport? Report { get; set; }

    /// <summary>Passenger count the shown price was calculated for (the input may have changed since).</summary>
    [Parameter]
    public int PricedPassengers { get; set; }

    [Parameter]
    public string? ValidationWarning { get; set; }

    [Parameter]
    public PipelineStepDiagnostic? SelectedStep { get; set; }

    [Parameter]
    public EventCallback<PipelineStepDiagnostic> SelectedStepChanged { get; set; }

    [Parameter]
    public bool CanUndo { get; set; }

    [Parameter]
    public bool CanRedo { get; set; }

    [Parameter]
    public EventCallback OnSearch { get; set; }

    [Parameter]
    public EventCallback OnUndo { get; set; }

    [Parameter]
    public EventCallback OnRedo { get; set; }

    [Parameter]
    public EventCallback OnUnknownStationDemo { get; set; }

    [Parameter]
    public EventCallback OnServiceFailureDemo { get; set; }

    /// <summary>"Clear simulated failures and retry" on an error result (MaybeView shows it to dispatchers only).</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    [Parameter]
    public EventCallback OnRestoreValidStations { get; set; }

    /// <summary>"Book this trip": Home switches to the Bookings tab.</summary>
    [Parameter]
    public EventCallback OnBookTrip { get; set; }

    /// <summary>"View timetable": Home switches to the Timetable tab.</summary>
    [Parameter]
    public EventCallback OnViewTimetable { get; set; }

    /// <summary>Cascaded by Home from the signed-in user; a missing value means Passenger.</summary>
    [CascadingParameter]
    public UserRole Role { get; set; }

    [CascadingParameter]
    public ViewOptions Options { get; set; } = ViewOptions.Default;

    // The station list never changes while the app runs, so it is read once per component.
    private IReadOnlyList<GeoCoord> Stations => _stations ??= MappingSystem.GetAllStations();
    private IReadOnlyList<GeoCoord>? _stations;

    private bool FailuresSimulated =>
        ChaosController.SimulateMappingServiceCrash || ChaosController.SimulateRoutePlannerCrash ||
        ChaosController.SimulateTrafficMonitorCrash || ChaosController.SimulatePricingCrash ||
        ChaosController.SimulatePaymentOutage;
}
