@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject RailwayPipelineOrchestrator Orchestrator
@inject ChaosAndTrafficController ChaosController
@inject ImmutableAppStateContainer AppState

@* The single page of the app. It owns what more than one tab needs: the signed-in user and role, the
   trip search (form, validation, last report, Undo/Redo) and the per-session state of the tabs, which
   has to outlive the tab components because only the open tab is rendered. Everything else is done by
   one component per tab in Components/Tabs. Which tabs exist depends on the role (Network and Dispatcher
   are for dispatchers) and on the "Course notes" switch (the Lab tab and the How-it-works notes). The
   role and the view options are cascaded to every component. *@

<PageTitle>RailFlow — rail journeys and bookings</PageTitle>

<CascadingValue Value="AppState.CurrentRole">
<CascadingValue Value="_viewOptions">
    <header class="app-header">
        <div class="container">
            <div class="header-row">
                <div class="brand">
                    <svg class="brand-mark" width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
                        <rect width="32" height="32" rx="6" fill="var(--accent)" />
                        <path d="M12 6 L9.5 26 M20 6 L22.5 26" stroke="#fff" stroke-width="2" stroke-linecap="round" />
                        <path d="M11.2 11h9.6 M10.6 16h10.8 M10 21h12" stroke="#fff" stroke-width="1.5" stroke-linecap="round" opacity="0.85" />
                    </svg>
                    <div>
                        <h1>RailFlow</h1>
                        <p>Rail journeys across Europe</p>
                    </div>
                </div>

                <div class="header-actions">
                    <label class="notes-toggle" title="Show how the functional techniques from the course are used">
                        <input type="checkbox" class="switch" checked="@_viewOptions.ShowCourseNotes" @onchange="ToggleCourseNotes" />
                        Course notes
                    </label>
                    @if (_signedInName is not null)
                    {
                        <span><strong>@_signedInName</strong></span>
                        <span class="tag">@(IsDispatcher ? "Dispatcher" : "Passenger")</span>
                        <form method="post" action="account/logout" class="inline-form">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm">Sign out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm" href="login">Sign in</a>
                    }
                </div>
            </div>

            <nav class="tabs" role="tablist" aria-label="Sections">
                @foreach (var group in VisibleTabs.GroupBy(t => t.Group))
                {
                    @if (group.Key is not null)
                    {
                        <span class="tab-group-label" aria-hidden="true">@group.Key</span>
                    }
                    @foreach (var tab in group)
                    {
                        var id = tab.Id;
                        <button role="tab" class="tab @(_activeTab == id ? "active" : "")"
                                aria-selected="@(_activeTab == id ? "true" : "false")"
                                @onclick="() => OpenTab(id)">
                            @tab.Title
                        </button>
                    }
                }
            </nav>
        </div>
    </header>

    <main class="container page">
        @switch (_activeTab)
        {
            case "plan":
                <PlanTab Inputs="_inputs"
                         Report="_lastReport"
                         PricedPassengers="_pricedPassengers"
                         ValidationWarning="@_validationWarning"
                         @bind-SelectedStep="_selectedStep"
                         CanUndo="AppState.CanUndo"
                         CanRedo="AppState.CanRedo"
                         OnSearch="ExecutePlannerPipeline"
                         OnUndo="HandleUndo"
                         OnRedo="HandleRedo"
                         OnUnknownStationDemo="TriggerNothingDemo"
                         OnServiceFailureDemo="TriggerErrorDemo"
                         OnRetry="ResetChaosAndReExecute"
                         OnRestoreValidStations="RestoreValidStations"
                         OnBookTrip='() => OpenTab("bookings")'
                         OnViewTimetable='() => OpenTab("timetable")' />
                break;

            case "bookings":
                @* The key changes on every click on the tab, so the component starts afresh and reloads the history. *@
                <BookingsTab @key="_bookingsOpened"
                             State="_bookings"
                             Report="_lastReport"
                             PricedPassengers="_pricedPassengers"
                             Origin="@_inputs.Origin"
                             OnPlanTrip='() => OpenTab("plan")' />
                break;

            case "timetable":
                <TimetableTab Route="PricedRoute" Departure="_inputs.Departure" OnPlanTrip='() => OpenTab("plan")' />
                break;

            case "network":
                <NetworkTab />
                break;

            case "dispatcher":
                <DispatcherTab Feed="AppState.LiveSignalRFeed"
                               SignedInName="@_signedInName"
                               OnRoadworksChanged="RepriceLastSearch" />
                break;

            case "lab":
                <LabTab State="_lab" Origin="@_inputs.Origin" Destination="@_inputs.Destination" />
                break;
        }
    </main>

    <footer class="app-footer">
        <div class="container">
            RailFlow · final project for Introduction to Functional Programming · Astana IT University, 2026
        </div>
    </footer>
</CascadingValue>
</CascadingValue>

@code {
    private sealed record TabInfo(string Id, string Title, string? Group);

    private static readonly TabInfo[] PassengerTabs =
    [
        new("plan", "Plan a trip", null),
        new("bookings", "Bookings", null),
        new("timetable", "Timetable", null)
    ];

    private static readonly TabInfo[] DispatcherTabs =
    [
        new("network", "Network", "Operations"),
        new("dispatcher", "Dispatcher", "Operations")
    ];

    private static readonly TabInfo[] CourseTabs = [new("lab", "Lab", "Course")];

    private IEnumerable<TabInfo> VisibleTabs =>
        PassengerTabs
            .Concat(IsDispatcher ? DispatcherTabs : [])
            .Concat(_viewOptions.ShowCourseNotes ? CourseTabs : []);

    private string _activeTab = "plan";
    private ViewOptions _viewOptions = ViewOptions.Default;

    // Trip search, used by several tabs
    private readonly PlannerInputs _inputs = new();
    private int _pricedPassengers = 2;
    private string? _validationWarning;
    private PipelineExecutionReport? _lastReport;
    private ValidRouteQuery? _lastQuery;
    private PipelineStepDiagnostic? _selectedStep;

    // What the tabs remember between visits (only the open tab's component exists at any time)
    private readonly BookingsTabState _bookings = new();
    private readonly LabTabState _lab = new();
    private int _bookingsOpened;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? _signedInName;

    // The role comes from the auth cookie (read once when the circuit starts), so the checks below are server-side.
    private bool IsDispatcher => AppState.CurrentRole == UserRole.DispatcherAdmin;

    private PlannedRoute? PricedRoute =>
        _lastReport?.Outcome is Something<PricedItinerary> { InnerValue: var it } ? it.TrafficRoute.Route : null;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            if (user.Identity?.IsAuthenticated == true)
                _signedInName = user.FindFirst(RoleNames.DisplayNameClaim)?.Value ?? user.Identity.Name;
            AppState.SetRole(RoleNames.FromPrincipal(user));
        }

        AppState.OnStateChanged += HandleStateChanged;
        ChaosController.OnTrafficAlertBroadcast += HandleTrafficAlert;

        _inputs.LoadFrom(AppState.CurrentSnapshot);
        ExecutePlannerPipelineInternal(commitHistory: false);
    }

    private void OpenTab(string id)
    {
        // A tab that is not offered to this visitor cannot be opened, whatever the click says.
        if (!VisibleTabs.Any(t => t.Id == id))
            return;

        _activeTab = id;
        if (id == "bookings")
            _bookingsOpened++;
    }

    private void ToggleCourseNotes()
    {
        _viewOptions = _viewOptions with { ShowCourseNotes = !_viewOptions.ShowCourseNotes };
        if (!VisibleTabs.Any(t => t.Id == _activeTab))
            _activeTab = "plan";
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    // Raised on whichever thread changed the shared controller (another user's circuit or the hub),
    // so the update is marshalled onto this circuit's dispatcher before touching its state.
    // Engineering works may have changed the fare, so a trip on screen is priced again; the progress
    // of a booking already made is kept.
    private void HandleTrafficAlert(string alert) =>
        InvokeAsync(() =>
        {
            AppState.AppendFeedMessage(alert);
            RepriceLastSearch();
            StateHasChanged();
        });

    // --- Trip search ---

    private void ExecutePlannerPipeline() => ExecutePlannerPipelineInternal(commitHistory: true);

    private void ExecutePlannerPipelineInternal(bool commitHistory)
    {
        var validation = RailwayPipelineOrchestrator.ValidateInput(
            _inputs.Origin, _inputs.Destination, _inputs.Passengers, _inputs.ToOffering());

        _validationWarning = validation switch
        {
            EmptyRouteQuery { FieldName: var f } => $"Please enter the {f.ToLowerInvariant()}.",
            SameStationError { Station: var s } => $"From and To are the same station ({UiText.Station(s)}).",
            InvalidPassengerCount => "Choose between 1 and 50 passengers.",
            _ => null
        };

        // Any new search, valid or not, clears the progress list of the previous booking attempt.
        _bookings.ClearStages();

        // Only a ValidRouteQuery reaches the pipeline; every other case of the union stops here with its message,
        // so an invalid search can never be priced or booked.
        if (validation is not ValidRouteQuery query)
        {
            _lastReport = null;
            _selectedStep = null;
            return;
        }

        if (commitHistory)
            AppState.CommitSnapshot(_inputs.ToSnapshot(DateTime.UtcNow));

        _lastQuery = query;
        PriceQuery(query);
    }

    // Prices the last valid search again (not what is typed in the form now), for example after another
    // dispatcher changed engineering works. The progress of a booking already made is kept.
    private void RepriceLastSearch()
    {
        if (_lastQuery is not null && _lastReport is not null)
            PriceQuery(_lastQuery);
    }

    private void PriceQuery(ValidRouteQuery query)
    {
        _pricedPassengers = query.Passengers;
        _lastReport = Orchestrator.ExecutePipeline(query.Origin, query.Destination, query.Offering, query.Passengers);
        _selectedStep = _lastReport.Diagnostics.LastOrDefault(d => d.Status != "Skipped") ?? _lastReport.Diagnostics.LastOrDefault();
    }

    private void TriggerNothingDemo()
    {
        _inputs.Origin = "LONDON";
        _inputs.Destination = "ATLANTIS";
        ExecutePlannerPipelineInternal(commitHistory: true);
    }

    private void TriggerErrorDemo()
    {
        if (!IsDispatcher) return;
        ChaosController.SimulateTrafficMonitorCrash = true;
        ExecutePlannerPipelineInternal(commitHistory: false);
        AppState.AppendFeedMessage("Simulated failure of the engineering works feed (from the planner).");
    }

    private void ResetChaosAndReExecute()
    {
        if (!IsDispatcher) return;
        ChaosController.SimulateMappingServiceCrash = false;
        ChaosController.SimulateRoutePlannerCrash = false;
        ChaosController.SimulateTrafficMonitorCrash = false;
        ChaosController.SimulatePricingCrash = false;
        ChaosController.SimulatePaymentOutage = false;
        ExecutePlannerPipelineInternal(commitHistory: false);
    }

    // Available to everyone: puts a known-good route back in the form and searches again.
    // It does not touch the shared failure switches; only a dispatcher can clear those.
    private void RestoreValidStations()
    {
        _inputs.Origin = "LONDON";
        _inputs.Destination = "ZURICH";
        ExecutePlannerPipelineInternal(commitHistory: true);
    }

    private void HandleUndo()
    {
        AppState.Undo();
        _inputs.LoadFrom(AppState.CurrentSnapshot);
        ExecutePlannerPipelineInternal(commitHistory: false);
    }

    private void HandleRedo()
    {
        AppState.Redo();
        _inputs.LoadFrom(AppState.CurrentSnapshot);
        ExecutePlannerPipelineInternal(commitHistory: false);
    }

    public void Dispose()
    {
        AppState.OnStateChanged -= HandleStateChanged;
        ChaosController.OnTrafficAlertBroadcast -= HandleTrafficAlert;
    }
}
