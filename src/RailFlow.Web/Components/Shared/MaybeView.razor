@typeparam TItem

<div class="maybe-view-container" role="region" aria-live="polite">
    @switch (State)
    {
        case Something<TItem> { InnerValue: { } item }:
            <div class="maybe-state maybe-something">
                <div class="maybe-badge badge-something">
                    <span class="dot"></span> Monad State: <code>Something&lt;@typeof(TItem).Name&gt;</code>
                </div>
                @if (SomethingTemplate is not null)
                {
                    @SomethingTemplate(item)
                }
            </div>
            break;

        case Error<TItem> { ErrorDetails: var ex }:
            <div class="maybe-state maybe-error" role="alert">
                <div class="maybe-badge badge-error">
                    <span class="dot"></span> Monad State: <code>@State.GetType().Name.Split('`')[0]&lt;@typeof(TItem).Name&gt;</code>
                </div>
                @if (ErrorTemplate is not null)
                {
                    @ErrorTemplate(ex)
                }
                else
                {
                    <div class="default-alert-box error-box">
                        <h4>Railway Bypass Track: Exception Captured Safely</h4>
                        <p>@ex.Message</p>
                        <small>Role Context: <strong>@ActiveRole</strong> — No unhandled crash occurred in the UI thread.</small>
                        @if (OnRetry.HasDelegate)
                        {
                            <div style="margin-top:0.75rem;">
                                <button class="btn-secondary" @onclick="() => OnRetry.InvokeAsync()">Reset Faults &amp; Retry Pipeline</button>
                            </div>
                        }
                    </div>
                }
            </div>
            break;

        case Nothing<TItem>:
        default:
            <div class="maybe-state maybe-nothing">
                <div class="maybe-badge badge-nothing">
                    <span class="dot"></span> Monad State: <code>Nothing&lt;@typeof(TItem).Name&gt;</code>
                </div>
                @if (NothingTemplate is not null)
                {
                    @NothingTemplate
                }
                else
                {
                    <div class="default-alert-box nothing-box">
                        <h4>No Matching Result (Nothing&lt;@typeof(TItem).Name&gt;)</h4>
                        <p>The functional pipeline short-circuited cleanly without null reference exceptions.</p>
                    </div>
                }
            </div>
            break;
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Maybe<TItem>? State { get; set; }

    [Parameter]
    public RenderFragment<TItem>? SomethingTemplate { get; set; }

    [Parameter]
    public RenderFragment? NothingTemplate { get; set; }

    [Parameter]
    public RenderFragment<Exception>? ErrorTemplate { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }

    [CascadingParameter]
    public UserRole ActiveRole { get; set; }
}
